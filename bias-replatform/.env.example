# Bias — environment variables (root)
# This file lists variable NAMES only. Never put real values here.
# Copy the relevant lines into the right dashboard (Render, Cloudflare
# Pages, or GitHub Secrets) and fill in real values there.

# --- Backend (Render env vars) ---
# Neon Postgres connection string
DATABASE_URL=change-me
# Frontend origin allowed by CORS (the Cloudflare Pages URL)
FRONTEND_ORIGIN=change-me
# Shared secret for the ingestion endpoint (also a GitHub Secret as BIAS_INGEST_KEY)
INGEST_KEY=change-me
# Optional, added later when keys exist
YOUTUBE_API_KEY=change-me
EBAY_CLIENT_ID=change-me
EBAY_CLIENT_SECRET=change-me

# --- Frontend (Cloudflare Pages env vars) ---
# Public backend address (not a secret)
PUBLIC_API_URL=change-me

# --- GitHub Actions secrets (repo Settings -> Secrets) ---
# BIAS_API_URL=change-me        (the Render service URL)
# BIAS_INGEST_KEY=change-me     (same value as INGEST_KEY)
